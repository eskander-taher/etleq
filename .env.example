# Core
DATABASE_URL=mongodb://127.0.0.1:27018/etleq?replicaSet=rs0&directConnection=true
# Signs admin sessions and scorecard result links (32+ random characters).
AUTH_SECRET=change-me-32-chars-minimum
# Atlas connection strings often have no database name; set it here.
DATABASE_NAME=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_ENV=development # development | staging | production

# Vercel Cron sends this as a bearer token to /api/cron/retention.
CRON_SECRET=

# Email via Resend (preferred). Sending-only key restricted to mail.etleq.com (key name: etleq-app-sending).
# Visitor emails use the published `notification-<locale>` templates; founder alerts are plain HTML.
RESEND_API_KEY=
RESEND_FROM="Etleq <hello@mail.etleq.com>"
# Real inbox for replies to visitor emails (mail.etleq.com has no inbox).
EMAIL_REPLY_TO=

# Email via SMTP (used only without RESEND_API_KEY; both empty = log to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Etleq <hello@etleq.com>"

# Forms / anti-spam
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Booking / contact
CAL_BOOKING_URL=
CAL_WEBHOOK_SECRET=
WHATSAPP_NUMBER=

# Analytics (each stays off until set)
GA4_ID=
GA4_API_SECRET=
CLARITY_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
SNAP_PIXEL_ID=
SNAP_CAPI_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_TOKEN=

# Search
INDEXNOW_KEY=
GOOGLE_INDEXING_SA_JSON=

# Monitoring / alerts
SENTRY_DSN=
LEAD_ALERT_EMAILS=
LEAD_ALERT_WEBHOOK=

# Browser tag ids (workstream E). Each tag loads only after consent and only when its id is set.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# Optional: Meta CAPI test code while verifying events in Events Manager.
META_TEST_EVENT_CODE=
# Playwright against a running server (default http://localhost:3000)
PLAYWRIGHT_BASE_URL=
