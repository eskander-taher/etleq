# Core
DATABASE_URL=mongodb://127.0.0.1:27017/etleq?replicaSet=rs0
PAYLOAD_SECRET=change-me-32-chars-minimum
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_ENV=development # development | staging | production

# Storage (production: S3-compatible, e.g. Cloudflare R2). Empty = local disk.
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Email (empty = log to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Etleq <hello@etleq.com>"

# Forms / anti-spam
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Booking / contact
CAL_BOOKING_URL=
CAL_WEBHOOK_SECRET=
WHATSAPP_NUMBER=

# Analytics (each stays off until set)
GA4_ID=
GA4_API_SECRET=
CLARITY_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
SNAP_PIXEL_ID=
SNAP_CAPI_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_TOKEN=

# Search
INDEXNOW_KEY=
GOOGLE_INDEXING_SA_JSON=

# Monitoring / alerts
SENTRY_DSN=
LEAD_ALERT_EMAILS=
LEAD_ALERT_WEBHOOK=
