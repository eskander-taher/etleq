{
  "name": "etleq-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check:samples && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && pnpm lint:logical",
    "lint:logical": "node scripts/check-logical-css.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "check:samples": "tsx scripts/check-samples.ts",
    "db:dev": "tsx scripts/dev-mongo.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@next/third-parties": "16.4.2",
    "@payloadcms/db-mongodb": "3.91.0",
    "@payloadcms/email-nodemailer": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/plugin-redirects": "3.91.0",
    "@payloadcms/plugin-seo": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "graphql": "16.14.2",
    "lucide-react": "1.57.0",
    "motion": "14.3.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "payload": "3.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "schema-dts": "2.1.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
